    {
      "id": "assumption_actions",
      "kind": "model_assumption",
      "description": "行动、目标权重和先后顺序是实验设定；每轮吴先于魏，每方最多推进一个行动。"
    },
    {
      "id": "assumption_resources",
      "kind": "model_assumption",
      "description": "兵力、粮秣和资源使用抽象单位；时间与耗损均为人工设定，不是原著统计。"
    },
    {
      "id": "assumption_defense",
      "kind": "model_assumption",
      "description": "袭取门槛=后方兵力+协同+额外戒备；诸葛亮留守使协同为2；这些是可替换假设。"
    },
    {
      "id": "assumption_information",
      "kind": "model_assumption",
      "description": "吴只在侦察或接触受阻后获得后方信息；魏的前线观察简化为可得补给等级。"
    },
    {
      "id": "assumption_diplomacy",
      "kind": "model_assumption",
      "description": "停战需要吴自行接受；模型只考虑有限目标，不代表真实谈判成功率。"
    },
    {
      "id": "assumption_orders",
      "kind": "model_assumption",
      "description": "第一版假设关羽执行刘备撤军令；道路由地区控制权聚合表示，暂不模拟拒令和行军风险。"
    },
    {
      "id": "assumption_outcomes",
      "kind": "model_assumption",
      "description": "后方失守与粮秣枯竭在本模型中足以导致被俘；攻城进度、压力和补给达到门槛时足以攻克樊城。"
    },
    {
      "id": "assumption_intervention",
      "kind": "model_assumption",
      "description": "反事实起点发生于北伐前：诸葛亮已从益州完成调遣；资源少2、益州参谋容量少1。行程时间未模拟。"
    }
  ]
